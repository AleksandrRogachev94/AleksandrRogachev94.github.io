---
import '../styles/tokens.css';
import '../styles/room.css';
import Room from '../components/Room.tsx';

// The room is one screenful at the top of a real page — it is not a replacement for the
// document and never hides it. Scroll past the room and the prose below is the same
// content the hotspots navigate to, server-rendered: the SEO layer, the screen-reader
// layer and the no-JS fallback, all at once (CLAUDE.md rule 2).
const title = 'Alex Rogachev';
const description = 'Software, computer vision, and things built indoors.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Room client:load />

    <main class="doc">
      <h1>{title}</h1>
      <p class="doc__lede">{description}</p>

      <section id="software">
        <h2>The software bench</h2>
        <p>
          Things that exist only as code live on the monitor. It is not one project — it is
          a bench that several sit on, each with its own page.
        </p>
        <p><a href="/software">Open the software bench →</a></p>
      </section>

      <section id="birdlense">
        <h2>BirdLense</h2>
        <p>
          A smart bird feeder in the yard outside the window: YOLO and ByteTrack for
          detection and tracking, BirdNET for the calls. It is a physical thing, so it has a
          physical address in the room.
        </p>
      </section>

      <section id="robotrail">
        <h2>RoboTrail</h2>
        <p>
          A tracked rover that builds a map of where it has been: graph SLAM running on a
          Raspberry Pi, closing loops against its own odometry. Like BirdLense it is a
          physical thing, so it sits on the floor rather than on the monitor.
        </p>
      </section>
    </main>

    <style>
      .doc {
        max-width: 62ch;
        margin: 0 auto;
        padding: 64px 24px 96px;
      }
      .doc h1 { font-size: 2rem; margin: 0 0 0.25em; }
      .doc__lede { color: var(--room-ink-soft); font-size: 1.1rem; margin-top: 0; }
      .doc section { margin-top: 48px; }
      .doc h2 { font-size: 1.25rem; margin: 0 0 0.4em; }
      .doc a { color: var(--room-ink); text-underline-offset: 3px; }
    </style>
  </body>
</html>
