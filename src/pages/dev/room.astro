---
// Development harness for the room renderer. Not linked from anywhere and not part of
// the site — it exists to answer one question from PLAN.md step 2: does the camera push
// read as movement through a space, or as a zoom into a photo?
import '../../styles/tokens.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>room renderer — dev</title>
  </head>
  <body>
    <canvas id="room"></canvas>

    <aside id="panel">
      <p id="status">loading…</p>
      <label>near z <input type="range" id="nearZ" min="0.4" max="3" step="0.05" value="1" /><output id="nearZOut">1.00</output></label>
      <label>far z <input type="range" id="farZ" min="2" max="20" step="0.1" value="6" /><output id="farZOut">6.0</output></label>
      <label>fov <input type="range" id="fov" min="20" max="80" step="1" value="42" /><output id="fovOut">42</output></label>
      <label>push depth <input type="range" id="travel" min="0.2" max="0.95" step="0.01" value="0.55" /><output id="travelOut">0.55</output></label>
      <label>edge cut <input type="range" id="edgeCut" min="0.02" max="1" step="0.01" value="1" /><output id="edgeCutOut">1.00</output></label>
      <label>parallax <input type="range" id="parallax" min="0" max="0.12" step="0.002" value="0.02" /><output id="parallaxOut">0.020</output></label>
      <label>lateral <input type="range" id="lateral" min="0" max="1" step="0.02" value="1" /><output id="lateralOut">1.00</output></label>
      <label>solo <input type="range" id="solo" min="-1" max="2" step="1" value="-1" /><output id="soloOut">all</output></label>
      <p class="hint">click a prop to push into it · Esc pulls back · wheel to dolly · solo isolates one layer</p>
    </aside>

    <style>
      html, body { height: 100%; }
      body { margin: 0; overflow: hidden; background: #000; }
      #room { display: block; width: 100vw; height: 100vh; cursor: crosshair; }
      #panel {
        position: fixed; top: 12px; left: 12px; width: 260px; padding: 12px 14px;
        background: color-mix(in srgb, var(--focus-surface) 88%, transparent);
        color: var(--focus-ink); border: 1px solid var(--focus-line); border-radius: 8px;
        font: 12px/1.5 var(--font-mono); backdrop-filter: blur(8px);
      }
      #panel label { display: grid; grid-template-columns: 4.5em 1fr 3em; align-items: center; gap: 6px; margin: 6px 0; }
      #panel input { width: 100%; accent-color: var(--accent); }
      #panel output { text-align: right; color: var(--accent); }
      #panel p { margin: 0 0 8px; }
      #status { color: var(--accent); }
      .hint { margin-top: 10px !important; color: var(--focus-ink-soft); font-size: 11px; }
    </style>

    <script>
      import { createRoomRenderer } from '../../scripts/roomRenderer';
      import { createCameraRig, PLATE, ROOM_TUNING } from '../../scripts/cameraRig';
      import { screenToImage } from '../../scripts/roomGeometry';

      // Back to front. The shell first, then furniture, then what stands on furniture.
      const S = '/art/room-day-summer';
      const LAYERS = [0, 1, 2].map((i) => ({
        colorSrc: `${S}-layer${i}.webp`,
        depthSrc: `${S}-layer${i}-depth.webp`,
      }));
      // Picking needs one depth map covering the whole frame; the per-layer ones are cut.
      // This is a harness affordance only. The site aims at authored points instead, so it
      // never downloads this plate or stalls the main thread reading it back.
      const DEPTH = `${S}-depth.webp`;

      const canvas = document.getElementById('room') as HTMLCanvasElement;
      const status = document.getElementById('status')!;
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const out = (id: string) => document.getElementById(id) as HTMLOutputElement;

      /** Read the depth map back on the CPU so a click can be turned into a 3D point. */
      async function depthSampler(src: string) {
        const img = await new Promise<HTMLImageElement>((res, rej) => {
          const i = new Image();
          i.onload = () => res(i); i.onerror = rej; i.src = src;
        });
        const c = document.createElement('canvas');
        c.width = img.naturalWidth; c.height = img.naturalHeight;
        const ctx = c.getContext('2d', { willReadFrequently: true })!;
        ctx.drawImage(img, 0, 0);
        const data = ctx.getImageData(0, 0, c.width, c.height).data;
        // nx, ny normalised on the art, origin top-left — the same convention as
        // hotspots.ts and roomGeometry.ts, so there is one orientation to remember.
        return (nx: number, ny: number) => {
          const x = Math.min(c.width - 1, Math.max(0, Math.round(nx * (c.width - 1))));
          const y = Math.min(c.height - 1, Math.max(0, Math.round(ny * (c.height - 1))));
          return data[(y * c.width + x) * 4] / 255;
        };
      }

      // ?grid=512 to trade geometric detail for framerate without editing code.
      const gridCols = Number(new URLSearchParams(location.search).get('grid')) || undefined;

      // The rig wants the renderer and the renderer wants the rig's per-frame callback, so
      // one of them has to be reached through a variable. One rAF is worth the indirection.
      let rig: ReturnType<typeof createCameraRig> | null = null;
      let pushing = false;

      const renderer = await createRoomRenderer({
        canvas,
        layers: LAYERS,
        gridCols,
        onBeforeFrame: (dt) => {
          rig?.update(dt);
          if (!rig) return;
          const reveal = rig.excursionPx();
          const over = reveal > PLATE.marginPx;
          status.textContent = `${pushing ? 'push' : 'home'} · excursion `
            + `${reveal.toFixed(0)}px / ${PLATE.marginPx}px${over ? ' OVER BUDGET' : ''}`;
          status.style.color = over ? '#ff6b6b' : '';
        },
      });

      if (!renderer) {
        status.textContent = 'no webgl2 — the site would show the static image here';
      } else {
        const sampleDepth = await depthSampler(DEPTH);
        const tuning = { ...ROOM_TUNING };
        rig = createCameraRig(renderer, renderer.imageAspect, tuning);

        /** Where on the art did the pointer land? Undoes the renderer's cover crop. */
        function pointOnArt(clientX: number, clientY: number): [number, number] {
          const r = canvas.getBoundingClientRect();
          return screenToImage(clientX - r.left, clientY - r.top, r.width, r.height, renderer!.imageAspect);
        }

        canvas.addEventListener('pointermove', (e) => {
          const r = canvas.getBoundingClientRect();
          rig!.setPointer(
            ((e.clientX - r.left) / r.width) * 2 - 1,
            1 - ((e.clientY - r.top) / r.height) * 2,
          );
        });

        canvas.addEventListener('click', (e) => {
          const [nx, ny] = pointOnArt(e.clientX, e.clientY);
          // Report what a hotspot entry would need to reproduce this push, so mapping an
          // aim point is a matter of clicking the thing and reading the console.
          const disparity = sampleDepth(nx, ny);
          console.log(`aim: [${nx.toFixed(3)}, ${ny.toFixed(3)}]  depth: ${disparity.toFixed(3)}`);
          rig!.pushToImagePoint(nx, ny, disparity);
          pushing = true;
        });

        addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { rig!.release(); pushing = false; }
        });

        let dolly = 0;
        canvas.addEventListener('wheel', (e) => {
          e.preventDefault();
          dolly = Math.min(1.5, Math.max(-1.5, dolly - e.deltaY * 0.002));
          rig!.setDolly(dolly);
        }, { passive: false });

        function bind(id: string, apply: (v: number) => void, fmt = (v: number) => v.toFixed(2)) {
          const el = $(id), o = out(id + 'Out');
          const run = () => { const v = parseFloat(el.value); o.value = fmt(v); apply(v); };
          el.addEventListener('input', run); run();
        }
        // Depth range and fov are duplicated state: the rig needs them to place an aim
        // point, the renderer needs them to draw. Both get written, from one slider.
        bind('nearZ', (v) => { tuning.nearZ = v; renderer.setDepthRange(tuning.nearZ, tuning.farZ); });
        bind('farZ', (v) => { tuning.farZ = v; renderer.setDepthRange(tuning.nearZ, tuning.farZ); }, (v) => v.toFixed(1));
        bind('fov', (v) => { tuning.fovDeg = v; renderer.setFov(v); }, (v) => v.toFixed(0));
        bind('travel', (v) => { tuning.travel = v; });
        bind('edgeCut', (v) => { renderer.setEdgeCut(v); });
        bind('parallax', (v) => { tuning.parallax = v; }, (v) => v.toFixed(3));
        bind('lateral', (v) => { tuning.lateral = v; });
        // Isolating a layer is how you tell a bad mask from a bad fill: a hole in the
        // shell is a mask that missed, a smear inside one layer is a layer that is missing.
        bind('solo', (v) => { renderer.setSoloLayer(v); }, (v) => (v < 0 ? 'all' : `L${v}`));

        status.textContent = 'home';
        renderer.start();
      }
    </script>
  </body>
</html>
